// Prisma Schema for NexaDesk Production Architecture
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  username     String          @unique
  name         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspaces   Workspace[]
  replays      SessionReplay[]

  @@map("users")
}

model Workspace {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  title       String
  description String?
  layout      String          @default("cascade")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       WorkspaceFile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("workspaces")
}

model WorkspaceFile {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  path        String
  content     String    @db.Text
  language    String    @default("typescript")
  sizeBytes   Int       @default(0) @map("size_bytes")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, path])
  @@map("workspace_files")
}

model SessionReplay {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  totalFrames Int      @default(0) @map("total_frames")
  durationMs  Float    @default(0) @map("duration_ms")
  metadata    Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("session_replays")
}

model TelemetryLog {
  id               String   @id @default(uuid())
  clientId         String   @map("client_id")
  fps              Float
  jitterVariancePx Float    @map("jitter_variance_px")
  filterLatencyMs  Float    @map("filter_latency_ms")
  gestureState     String   @map("gesture_state")
  createdAt        DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("telemetry_logs")
}
